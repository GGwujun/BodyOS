    "@tarojs/react": "3.6.27",
    "@tarojs/runtime": "3.6.27",
    "@tarojs/shared": "3.6.27",
    "@tarojs/taro": "3.6.27",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.17",
