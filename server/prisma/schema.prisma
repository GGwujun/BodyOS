// Body OS — Prisma schema(PostgreSQL)
// 9 实体,均 User 中心化。对齐 design/diagrams/01-Core-ER 与 app/src/services/types.ts

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  nickname  String
  avatar    String?
  timezone  String   @default("Asia/Shanghai")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  /// 微信 openid(静默登录换取);本地开发用户无 openid
  openid    String?  @unique

  profile       UserProfile?
  goals         Goal[]
  foodLogs      FoodLog[]
  activities    ActivityRecord[]
  summaries     DailySummary[]
  measurements  BodyMeasurement[]
  dataSources   DataSource[]
  conversations AIConversation[]
  analytics     AnalyticsEvent[]
  authTokens    AuthToken[]
  weeklyReports WeeklyReport[]
  waterLogs     WaterLog[]
  trainingDocs  TrainingDoc[]
  reminder      TrainingReminder?
}

/// 登录令牌(不透明随机串;签发后 30 天过期,客户端存本地)
model AuthToken {

  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 微信 session_key(解密 getWeRunData 等加密数据用;随登录轮换)
  sessionKey String?
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
}

model UserProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gender          String   @default("male") // male|female|other
  birthDate       DateTime?
  heightCm        Float?
  weightKg        Float?
  activityLevel   String   @default("moderate") // sedentary|light|moderate|active|very_active
  dietPreference  String?
  trainingPref    String?
  /// 每日饮水目标(毫升)
  waterGoalMl     Int      @default(1500)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Goal {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         String // fat_loss|muscle_gain|maintain|endurance
  targetValue  Float
  unit         String
  durationWeeks Int?
  startDate    DateTime @default(now())
  progress     Float    @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

model FoodLog {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date          DateTime  @db.Date
  meal          String // breakfast|lunch|dinner|snack
  items         Json // FoodItem[]
  totalCalories Float
  proteinG      Float     @default(0)
  carbG         Float     @default(0)
  fatG          Float     @default(0)
  fiberG        Float     @default(0)
  source        String    @default("manual") // manual|ai_text|ai_image
  loggedAt      DateTime  @default(now())
  createdAt     DateTime  @default(now())
  deletedAt     DateTime?

  @@index([userId, date])
  @@index([userId, meal])
}

model ActivityRecord {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date         DateTime  @db.Date
  type         String
  durationMin  Int?
  calories     Float
  /// 距离(米)。只存距离和时长,配速/速度在客户端算 —— 同一件事存两份迟早自相矛盾
  distanceM    Int?
  /// 跑步机坡度(%),0.5 一格。沿用 openGym 同一口径(那里叫 incline)
  inclinePct   Float?
  steps        Int?
  startedAt    DateTime
  source       String    @default("manual") // manual|ai_text|wechat|apple_health|mi|huami|training
  provider     String?
  externalId   String?
  deduplicated Boolean   @default(false)
  confidence   Float?
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  @@unique([userId, provider, externalId])
  @@index([userId, date])
}

model DailySummary {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date             DateTime @db.Date
  bodyScore        Float?
  energyScore      Float?
  nutritionScore   Float?
  activityScore    Float?
  recoveryScore    Float?
  goalScore        Float?
  intakeCalories   Float    @default(0)
  burnCalories     Float?
  netCalories      Float?
  bmr              Float?
  tdee             Float?
  steps            Int      @default(0)
  activeCalories   Float    @default(0)
  exerciseCalories Float    @default(0)
  /// 当日水分摄入合计(毫升),来自 WaterLog
  waterMl          Int      @default(0)
  nutrition        Json     @default("{\"proteinG\":0,\"carbG\":0,\"fatG\":0,\"fiberG\":0}")
  engineVersion    String   @default("v1")
  recalculatedAt   DateTime @default(now())

  @@unique([userId, date])
}

/// 每日水分打卡(一天一行,累加)
model WaterLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  amountMl  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
}

model BodyMeasurement {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  measuredAt DateTime
  weightKg   Float?
  bodyFatPct Float?
  muscleKg   Float?
  /// 围度(厘米),按量取部位分开存;一次只量一两处也允许
  waistCm    Float?
  chestCm    Float?
  hipCm      Float?
  armCm      Float?
  thighCm    Float?
  createdAt  DateTime @default(now())

  @@index([userId, measuredAt])
}

model DataSource {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider    String // wechat|apple_health|mi|huami
  name        String
  status      String    @default("disconnected") // disconnected|connecting|connected|syncing|synced|error
  cursor      String?
  lastSyncAt  DateTime?
  lastError   String?
  permissions Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, provider])
}

model SyncRawRecord {
  id         String   @id @default(cuid())
  userId     String
  provider   String
  externalId String
  payload    Json
  fetchedAt  DateTime @default(now())

  @@unique([userId, provider, externalId])
  @@index([userId, provider, fetchedAt])
}

model AIConversation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String // user|assistant
  content   String
  context   Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

/// 埋点事件(docs/03)
model AnalyticsEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String   // 事件名,如 home_view / ai_food_parse_confirm
  category  String   // 激活 / 首页 / AI / 数据源
  props     Json?    // 事件附加属性
  occurredAt DateTime @default(now())

  @@index([userId, name, occurredAt])
  @@index([occurredAt])
}

/// 周报缓存:按 userId+weekStart 落库,同一周不重复调用模型
model WeeklyReport {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStart   DateTime @db.Date
  content     Json     // 周报结构化结果(score/grade/changes/wins/issues/actions)
  generatedAt DateTime @default(now())

  @@unique([userId, weekStart])
}

/// 训练域文档云端镜像(计划/渐进/日志/备注/器材/照片索引/请假条)。
/// 客户端原本只存在本机 storage,换设备即丢;这里按「文档」粒度存:
/// plan/progress/notes/kit/daynotes 各一个文档,每条训练日志单独一个文档 —— 合并时不必解开大 blob,
/// 冲突也只影响单条。服务端只做 last-write-wins 的哑存储,真正的合并规则在客户端(见 utils/training-sync)。
model TrainingDoc {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// plan | progress | logs | notes | kit | photos | maxes | daynotes | dayassign | favs | custom
  kind     String
  /// 同一 kind 下的文档键:单例 kinds 用 "main",logs 用日志 id
  docKey   String
  payload  Json
  /// 乐观并发用的版本号,每次落库 +1
  rev      Int      @default(1)
  /// 客户端最后修改时间 —— 冲突比较用客户端时钟(服务端 updatedAt 只记落库时间)
  clientUpdatedAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, kind, docKey])
  @@index([userId, updatedAt])
}

/// 训练提醒设置 + 订阅消息的剩余可发次数。
/// 为什么不走 TrainingDoc:订阅消息的「还剩几条能发」是**只有服务端知道**的状态
/// (客户端推上去的文档带 lww 时间戳,会和它互相覆盖),而且调度器要按时间
/// 反查所有开着的用户 —— 那是一张有索引的小表,不是一堆 JSON 文档。
model TrainingReminder {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  enabled     Boolean  @default(false)
  /// 本地时间的 HH:mm
  time        String   @default("20:00")
  /// gentle | fun | cheer —— 和客户端 engine/nudge.ts 的三档语气对齐
  tone        String   @default("gentle")
  /// 计划日没练的当晚再补一次提醒
  nudge       Boolean  @default(true)
  /// 客户端时区相对 UTC 的分钟数(东八区 = 480)。服务端按它算「用户那边的 20:00」
  tzOffsetMin Int      @default(480)
  /// 订阅消息还剩几条能发:用户每授权一次 +1,发出成功一条 -1
  grants      Int      @default(0)
  /// 最后一次发出提醒的**用户本地日期**(YYYY-MM-DD),一天最多一条
  lastSentOn  String?
  lastSentAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([enabled])
}
