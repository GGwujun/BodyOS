# 数据库(PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bodyos?schema=public"

# 智谱 AI(在 https://open.bigmodel.cn/ 控制台获取)
ZHIPU_API_KEY=your_zhipu_api_key_here
ZHIPU_MODEL=glm-4-flash

# 服务
PORT=3000
NODE_ENV=development

# 微信小程序登录(管理后台"开发管理-开发设置"获取;AppSecret 严禁提交仓库)
WECHAT_APPID=your_appid_here
WECHAT_APP_SECRET=your_app_secret_here

# 小程序 request 合法域名需在微信后台配置本服务公网地址
